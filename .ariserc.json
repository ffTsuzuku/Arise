// Arise Local Repository Configuration
// Values omitted here are inherited from the selected preset.
{
  "$schema": "./arise.schema.json",
  "preset": "main",
  "repo": {
    "defaultBaseBranch": "main",
    "protectedBranches": [
      "main",
      "master",
      "develop",
      "prod",
      "staging"
    ]
  },
  "workspace": {
    "labelPrefix": "[arise] "
  },
  "multiplexer": "herdr"
}
